{
  "name": "cube-dsh-free",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Free local search and fetch backend for DSH web_search / web_fetch: pick official, free local sources, or auto-fallback; per-source cookies and user-defined search sources.",
  "author": "cubestudio-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubestudio-dev/Cube_DSH_Free-local-search.git"
  },
  "homepage": "https://github.com/cubestudio-dev/Cube_DSH_Free-local-search#readme",
  "bugs": {
    "url": "https://github.com/cubestudio-dev/Cube_DSH_Free-local-search/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market-index.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "web-search",
    "web-fetch",
    "deepseek-harness",
    "cordis",
    "free"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.5 || >=0.2.2-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "verify:index": "node scripts/verify-market-index.mjs",
    "test": "node scripts/run-tests.mjs && node scripts/test-live-cookies.mjs && node scripts/test-client.mjs",
    "test:live": "node --use-system-ca scripts/run-tests.mjs test-live-search.mjs test-live-custom.mjs"
  }
}
